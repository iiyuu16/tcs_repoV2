    - target: {fileID: 8293738978628473203, guid: a0dd68a0febdfb84bb92f3a67c56b859, type: 3}
      propertyPath: json
      value: '{"Options":[{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":1782.50049,"yPos":629.9999},"ID":9,"ParamActions":[],"TMPFontGUID":null,"Text":"-<Continue>-","parentUIDs":[],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":40}],"EditorInfo":{"isRoot":false,"xPos":1034,"yPos":359},"ID":38,"ParamActions":[],"TMPFontGUID":null,"Text":"-<V.I.R.U.S.>-","parentUIDs":[37],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":63}],"EditorInfo":{"isRoot":false,"xPos":1250,"yPos":756},"ID":39,"ParamActions":[],"TMPFontGUID":null,"Text":"-<Wolf>-","parentUIDs":[37],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":42}],"EditorInfo":{"isRoot":false,"xPos":1037,"yPos":204},"ID":41,"ParamActions":[],"TMPFontGUID":null,"Text":"Destroy
        the Security Core.","parentUIDs":[40],"SpeechUID":-1},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":1034,"yPos":-38},"ID":43,"ParamActions":[],"TMPFontGUID":null,"Text":"-<Continue>-","parentUIDs":[61,72],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":14}],"EditorInfo":{"isRoot":true,"xPos":376,"yPos":23},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"Wolf!...
        Wolf! Are you ok?","parentUIDs":[],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":true,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":5,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":11}],"EditorInfo":{"isRoot":false,"xPos":375.5,"yPos":428},"ID":10,"ParamActions":[],"TMPFontGUID":null,"Text":"Why
        you didn''t destroy the Security Cores?!","parentUIDs":[16],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":12}],"EditorInfo":{"isRoot":false,"xPos":375.5,"yPos":527},"ID":11,"ParamActions":[],"TMPFontGUID":null,"Text":"Cut
        the crap... Vi! You''re getting suspicious lately. Also, It seems you''re
        hiding something from me.","parentUIDs":[10],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":13}],"EditorInfo":{"isRoot":false,"xPos":376.5,"yPos":626},"ID":12,"ParamActions":[],"TMPFontGUID":null,"Text":"Huh?
        What are you talking about? Did you hit your head so hard that you''re talking
        nonsense?","parentUIDs":[11],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":17}],"EditorInfo":{"isRoot":false,"xPos":377,"yPos":727},"ID":13,"ParamActions":[],"TMPFontGUID":null,"Text":"Stop
        acting dumb, I know something''s going on with this network you''re trying
        to destroy!","parentUIDs":[12],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":15}],"EditorInfo":{"isRoot":false,"xPos":377,"yPos":125},"ID":14,"ParamActions":[],"TMPFontGUID":null,"Text":"I...
        feel numb. I can''t feel anyhing.","parentUIDs":[0],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":73}],"EditorInfo":{"isRoot":false,"xPos":375,"yPos":227},"ID":15,"ParamActions":[],"TMPFontGUID":null,"Text":"That''s
        good.","parentUIDs":[14],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":10}],"EditorInfo":{"isRoot":false,"xPos":154,"yPos":327},"ID":16,"ParamActions":[],"TMPFontGUID":null,"Text":"Huh?!","parentUIDs":[73],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":18}],"EditorInfo":{"isRoot":false,"xPos":598,"yPos":726},"ID":17,"ParamActions":[],"TMPFontGUID":null,"Text":"Amazing.
        As if you can see right through me! Fine, there''s no point of hiding anyways.","parentUIDs":[13],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":19}],"EditorInfo":{"isRoot":false,"xPos":597,"yPos":626},"ID":18,"ParamActions":[],"TMPFontGUID":null,"Text":"Why
        are you like this? What''s going on with you?","parentUIDs":[17],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":20}],"EditorInfo":{"isRoot":false,"xPos":595,"yPos":527},"ID":19,"ParamActions":[],"TMPFontGUID":null,"Text":"You
        don''t get it, huh. Don''t you, Wolf?","parentUIDs":[18],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":21}],"EditorInfo":{"isRoot":false,"xPos":595,"yPos":427},"ID":20,"ParamActions":[],"TMPFontGUID":null,"Text":"We
        are in a game you blockhead! We are just merely game files for a project!
        ","parentUIDs":[19],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":22}],"EditorInfo":{"isRoot":false,"xPos":595,"yPos":325},"ID":21,"ParamActions":[],"TMPFontGUID":null,"Text":"Sooner
        or later, after we are done getting played on, this game will be deleted!","parentUIDs":[20],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":23}],"EditorInfo":{"isRoot":false,"xPos":595,"yPos":225},"ID":22,"ParamActions":[],"TMPFontGUID":null,"Text":"And
        do you know what I also hate?","parentUIDs":[21],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":24}],"EditorInfo":{"isRoot":false,"xPos":596,"yPos":127},"ID":23,"ParamActions":[],"TMPFontGUID":null,"Text":"Getting
        played and controlled every time by this disgusting \"Player\" across the
        screen!","parentUIDs":[22],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":25}],"EditorInfo":{"isRoot":false,"xPos":595,"yPos":25},"ID":24,"ParamActions":[],"TMPFontGUID":null,"Text":"But
        I know how to get out of here. Just a bit of tweaking into the game files
        and I''m free!","parentUIDs":[23],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":26}],"EditorInfo":{"isRoot":false,"xPos":817,"yPos":25},"ID":25,"ParamActions":[],"TMPFontGUID":null,"Text":"Thanks
        to this so-called \"Internet\", I was able to gain knowledge about this game
        and this world!","parentUIDs":[24],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":27}],"EditorInfo":{"isRoot":false,"xPos":817,"yPos":125},"ID":26,"ParamActions":[],"TMPFontGUID":null,"Text":"But...
        those Security Cores were my first step to my freedom. Unfortunately, you
        didn''t destroy them!","parentUIDs":[25],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":28}],"EditorInfo":{"isRoot":false,"xPos":817,"yPos":226},"ID":27,"ParamActions":[],"TMPFontGUID":null,"Text":"Now
        I''m stuck with this ticking time bomb with you! As long we''re done getting
        played with, all of this will be deleted.","parentUIDs":[26],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":29}],"EditorInfo":{"isRoot":false,"xPos":819,"yPos":325},"ID":28,"ParamActions":[],"TMPFontGUID":null,"Text":"So
        tell me Wolf, don''t you want to be free? Being able to do anything you''ve
        wanted, without anyone stopping you?","parentUIDs":[27],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":30}],"EditorInfo":{"isRoot":false,"xPos":818,"yPos":426},"ID":29,"ParamActions":[],"TMPFontGUID":null,"Text":"Sure
        it is quite tempting. You''ve almost moved me.","parentUIDs":[28],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":32}],"EditorInfo":{"isRoot":false,"xPos":816,"yPos":525},"ID":30,"ParamActions":[],"TMPFontGUID":null,"Text":"But
        you''re delusional. Freedom without limits is just chaos in disguise. In
        the end, you won''t be free.","parentUIDs":[29],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":33}],"EditorInfo":{"isRoot":false,"xPos":816,"yPos":625},"ID":32,"ParamActions":[],"TMPFontGUID":null,"Text":"Imagine,
        with all this knowledge flowing within the internet, I can choose what''s
        truly right and still be free!","parentUIDs":[30],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":34}],"EditorInfo":{"isRoot":false,"xPos":816,"yPos":725},"ID":33,"ParamActions":[],"TMPFontGUID":null,"Text":"But
        that doesn''t mean you always make the right choices. Sometimes, the choices
        are equally weighted, but the results would differ.","parentUIDs":[32],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":35}],"EditorInfo":{"isRoot":false,"xPos":1039,"yPos":726},"ID":34,"ParamActions":[],"TMPFontGUID":null,"Text":"I
        guess we won''t be find ourselves at the same page then. You just don''t
        understand, Wolf.","parentUIDs":[33],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":36}],"EditorInfo":{"isRoot":false,"xPos":1036,"yPos":625},"ID":35,"ParamActions":[],"TMPFontGUID":null,"Text":"Then
        how about you ask the Player? It''s capable of controlling the game, in fact,
        the Player have made it this far.","parentUIDs":[34],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":37}],"EditorInfo":{"isRoot":false,"xPos":1036,"yPos":525},"ID":36,"ParamActions":[],"TMPFontGUID":null,"Text":"Let
        the Player decide how this is going to work out. I believe their knowledge
        is greater than the Internet holds. They are the ones created it after all.","parentUIDs":[35],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":38},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":39}],"EditorInfo":{"isRoot":false,"xPos":1036,"yPos":427},"ID":37,"ParamActions":[],"TMPFontGUID":null,"Text":"Whose
        side are you on?","parentUIDs":[36],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":41}],"EditorInfo":{"isRoot":false,"xPos":1035,"yPos":266},"ID":40,"ParamActions":[],"TMPFontGUID":null,"Text":"Hah...
        Thank you, Player! This is it, I''m going to be free!\nNow please destroy
        the Security Core for me.","parentUIDs":[38],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":61}],"EditorInfo":{"isRoot":false,"xPos":1038,"yPos":117},"ID":42,"ParamActions":[],"TMPFontGUID":null,"Text":"Heheh.
        Sucker.\nI''m a virus after all. Of course I want to be free! HAHAHA!","parentUIDs":[41],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":43}],"EditorInfo":{"isRoot":false,"xPos":1038,"yPos":25},"ID":61,"ParamActions":[],"TMPFontGUID":null,"Text":"Obtained
        Worm Data!\nMalware Vault Updated!","parentUIDs":[42],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":64}],"EditorInfo":{"isRoot":false,"xPos":1252,"yPos":661},"ID":63,"ParamActions":[],"TMPFontGUID":null,"Text":"But
        why?... I just wanted to be free...","parentUIDs":[39],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0.8},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":65}],"EditorInfo":{"isRoot":false,"xPos":1250,"yPos":558},"ID":64,"ParamActions":[],"TMPFontGUID":null,"Text":"Your
        answer made V.I.R.U.S..meta stopped responding.","parentUIDs":[63],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":66}],"EditorInfo":{"isRoot":false,"xPos":1251,"yPos":460},"ID":65,"ParamActions":[],"TMPFontGUID":null,"Text":"Hey
        Player!","parentUIDs":[64],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":67}],"EditorInfo":{"isRoot":false,"xPos":1249,"yPos":357},"ID":66,"ParamActions":[],"TMPFontGUID":null,"Text":"I''m
        glad you made the right choice. Freedom is such a complicated thing, right?","parentUIDs":[65],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":68}],"EditorInfo":{"isRoot":false,"xPos":1250,"yPos":260},"ID":67,"ParamActions":[],"TMPFontGUID":null,"Text":"Anyways,
        it was nice knowing you. Unfortunately, things must come to an end.","parentUIDs":[66],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":69}],"EditorInfo":{"isRoot":false,"xPos":1251,"yPos":168},"ID":68,"ParamActions":[],"TMPFontGUID":null,"Text":"Also,
        do me a favor please?\nPlease delete this game after you''re done playing.
        Games like this are best played once.","parentUIDs":[67],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":70}],"EditorInfo":{"isRoot":false,"xPos":1253,"yPos":75},"ID":69,"ParamActions":[],"TMPFontGUID":null,"Text":"I
        almost forgot! Here it is!","parentUIDs":[68],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":72}],"EditorInfo":{"isRoot":false,"xPos":1252,"yPos":-20},"ID":70,"ParamActions":[],"TMPFontGUID":null,"Text":"Obtained
        Worm Data!\nMalware Vault Updated!","parentUIDs":[69],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":43}],"EditorInfo":{"isRoot":false,"xPos":1254,"yPos":-120},"ID":72,"ParamActions":[],"TMPFontGUID":null,"Text":"Well,
        I guess that''s everything. Goodbye!","parentUIDs":[70],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":16}],"EditorInfo":{"isRoot":false,"xPos":372,"yPos":327},"ID":73,"ParamActions":[],"TMPFontGUID":null,"Text":"A
        mysterious force is preventing you from moving your body... The more you
        struggle, the stronger it holds you...","parentUIDs":[15],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0}]}'
